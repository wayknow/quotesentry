# Express local fallback. Worker development reads .dev.vars instead.
PORT=3001
APP_MODE=demo
SEND_MODE=disabled
DB_PATH=./data/db.json

# Optional HTTP Basic Auth for staging/demo. Leave both blank to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# DeepSeek server-side API. The key never reaches the browser.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_RETRIES=1
