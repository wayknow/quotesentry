# Local Worker secrets. Copy to .dev.vars; never commit .dev.vars.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_RETRIES=1

# Optional Basic Auth for staging. Leave both blank to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
